{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node", "electron"],
    "noEmit": true
  },
  "include": [
    "electron-vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/common/**/*.ts"
  ]
}
