{
  "name": "ultimate-wordpress-and-website-auditor",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows application for comprehensive technical and security auditing of WordPress and web sites.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
